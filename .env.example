# ── Met Office SFTP (required for forecast data seeding) ──────────────────────
# SSH_PRIVATE_KEY must be the base64-encoded full PEM text (with headers) of the
# OpenSSH private key. See README.md "Setting up the SSH private key" for instructions.
SSH_PRIVATE_KEY=

# ── Met Office SFTP directory ──────────────────────────────────────────────────
MET_OFFICE_DIRECTORY=/Incoming Shares/AQIE/MetOffice/

# ── Cron schedules (optional — override to seed the DB immediately during local dev) ──
# Set to "* * * * *" to trigger every minute, then revert once data is populated.
# FORECAST_SCHEDULE=* * * * *
# FORECAST_RETRY_INTERVAL=900000